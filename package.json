{
  "name": "rampspec-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation for RampSpec's Stellar SEP conformance and interoperability platform.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && npm run lint && npm run export && node scripts/extract-mintlify-export.mjs",
    "dev": "mintlify dev",
    "export": "node scripts/prepare-mintlify-export.mjs && mintlify export --output export.zip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:openapi": "node scripts/import-openapi.mjs",
    "import:schemas": "node scripts/import-schema-bundle.mjs",
    "lint": "npm run lint:mintlify && npm run lint:content && npm run lint:manifests && npm run lint:openapi && npm run lint:schemas && npm run lint:references && npm run lint:snippets && npm run lint:spelling && npm run format:check",
    "lint:content": "node scripts/validate-docs.mjs",
    "lint:external": "node scripts/check-external-links.mjs",
    "lint:manifests": "node scripts/validate-release-manifest.mjs",
    "lint:mintlify": "mintlify broken-links",
    "lint:openapi": "node scripts/validate-openapi.mjs",
    "lint:schemas": "node scripts/validate-schema-bundle.mjs",
    "lint:references": "node scripts/validate-references.mjs",
    "lint:snippets": "node scripts/validate-snippets.mjs",
    "lint:spelling": "cspell --config cspell.json .",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "adm-zip": "0.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cspell": "10.3.0",
    "mintlify": "4.2.884",
    "prettier": "3.9.6",
    "typescript": "5.9.2"
  }
}
