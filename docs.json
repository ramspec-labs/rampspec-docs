{
  "$schema": "https://mintlify.com/docs.json",
  "name": "RampSpec",
  "description": "Continuous SEP conformance, interoperability testing, and verifiable evidence for Stellar anchors.",
  "theme": "maple",
  "public": false,
  "colors": {
    "primary": "#22d3ee",
    "light": "#67e8f9",
    "dark": "#0891b2"
  },
  "logo": {
    "dark": "/assets/images/logo.svg",
    "light": "/assets/images/logo.svg",
    "href": "/introduction"
  },
  "favicon": "/assets/images/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/rampspec-labs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "View App",
      "href": "https://github.com/rampspec-labs/rampspec-frontend"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/rampspec-labs"
    }
  },
  "search": {
    "prompt": "Search RampSpec documentation"
  },
  "seo": {
    "indexing": "navigable",
    "trailingSlash": false,
    "metatags": {
      "robots": "noindex, nofollow",
      "referrer": "strict-origin-when-cross-origin"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "boost": 3,
            "pages": ["introduction", "getting-started", "roadmap"]
          },
          {
            "group": "Architecture",
            "pages": ["architecture/overview"]
          },
          {
            "group": "Contracts",
            "pages": ["contracts/overview", "reference/contract-storage"]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/terminology",
              "reference/release-manifest",
              "reference/schemas"
            ]
          },
          {
            "group": "Standards",
            "pages": [
              "reference/standards-baseline",
              "governance/rule-classification"
            ]
          },
          {
            "group": "Governance",
            "pages": [
              "governance/repository-ownership",
              "governance/docs-release-policy",
              "governance/docs-deployment"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "SDK",
            "pages": ["sdk/overview"]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guides",
            "pages": ["guides/getting-started", "guides/test-modes"]
          },
          {
            "group": "Maintainers",
            "pages": ["guides/maintainers/spec-synchronization"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": ["api-reference/endpoints"]
          }
        ]
      }
    ]
  }
}
