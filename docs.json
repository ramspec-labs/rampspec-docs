            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "guides/integrations/github-ci",
              "guides/integrations/continuous-monitoring"
            ]
          },
          {
            "group": "Maintainers",
            "pages": ["guides/maintainers/spec-synchronization"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": ["api-reference/endpoints"]
          }
        ]
      }
    ]
  }
}
