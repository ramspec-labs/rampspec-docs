{
  "$schema": "https://mintlify.com/docs.json",
  "name": "RampSpec",
  "description": "Continuous SEP conformance, interoperability testing, and verifiable evidence for Stellar anchors.",
  "theme": "maple",
  "public": false,
  "colors": {
    "primary": "#22d3ee",
    "light": "#67e8f9",
    "dark": "#0891b2"
  },
  "logo": {
    "dark": "/assets/images/logo.svg",
    "light": "/assets/images/logo.svg",
    "href": "/introduction"
  },
  "favicon": "/assets/images/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/rampspec-labs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "View App",
      "href": "https://github.com/rampspec-labs/rampspec-frontend"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/rampspec-labs"
    }
  },
  "search": {
    "prompt": "Search RampSpec documentation"
  },
  "seo": {
    "indexing": "navigable",
    "trailingSlash": false,
    "metatags": {
      "robots": "noindex, nofollow",
      "referrer": "strict-origin-when-cross-origin"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "boost": 3,
            "pages": ["introduction", "getting-started", "roadmap"]
          },
          {
            "group": "Architecture",
            "pages": ["architecture/overview"]
          },
          {
            "group": "Contracts",
            "pages": [
              "contracts/overview",
              "contracts/evidence-guide",
              "contracts/administration-and-upgrades",
              "reference/contract-storage"
            ]
          },
          {
            "group": "Reports",
            "pages": [
              "reports/interpretation",
              "reports/verification-and-sharing"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/terminology",
              "reference/release-manifest",
              "reference/schemas",
              "reference/scenario-language",
              "reference/cli"
            ]
          },
          {
            "group": "Standards",
            "pages": [
              "reference/standards-baseline",
              "governance/rule-classification"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/threat-model",
              "security/data-handling-and-operations"
            ]
          },
          {
            "group": "Governance",
            "pages": [
              "governance/repository-ownership",
              "governance/docs-release-policy",
              "governance/docs-deployment"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "SDK",
            "pages": [
              "sdk/overview",
              "sdk/api-client",
              "sdk/report-verifier",
              "sdk/schema-helpers",
              "sdk/webhook-verification",
              "sdk/runner-integration",
              "sdk/contract-lookups"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guides",
            "pages": ["guides/getting-started", "guides/test-modes"]
          },
          {
            "group": "Onboarding",
            "pages": [
              "guides/organization-setup",
              "guides/target-onboarding",
              "guides/first-sep1-run",
              "guides/ci-gate"
            ]
          },
          {
            "group": "Anchor Platform",
            "pages": [
              "guides/anchor-platform/reference-environment",
              "guides/anchor-platform/integration",
              "guides/anchor-platform/troubleshooting"
            ]
          },
          {
            "group": "Protocols",
            "pages": [
              "guides/protocols/sep-1",
              "guides/protocols/sep-10",
              "guides/protocols/sep-45",
              "guides/protocols/sep-9",
              "guides/protocols/sep-12",
              "guides/protocols/sep-6-deposit",
              "guides/protocols/sep-6-withdrawal",
              "guides/protocols/sep-24",
              "guides/protocols/sep-38",
              "guides/protocols/sep-31-corridor",
              "guides/protocols/sep-31-negative-paths",
              "guides/protocols/sep-34"
            ]
          },
          {
            "group": "Scenarios",
            "pages": ["guides/scenario-cookbook"]
          },
          {
            "group": "Runner Operations",
            "pages": [
              "operations/runners/public-runner",
