{
  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "files": ["**/*.{md,mdx,json,yml,yaml,mjs}"],
  "ignorePaths": [
    "implementation.md",
    "package-lock.json",
    "assets/images/*.svg",
    "assets/diagrams/*.svg",
